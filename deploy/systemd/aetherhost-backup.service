[Unit]
Description=AetherHost encrypted off-host backup
Wants=docker.service
After=docker.service network-online.target
OnFailure=aetherhost-operation-alert@%n.service

[Service]
Type=oneshot
# A backup that cannot make progress must fail visibly rather than silently
# occupying the daily job forever. Four hours comfortably covers normal runs.
TimeoutStartSec=4h
Environment=HOME=/root
Environment=XDG_CACHE_HOME=/var/cache/aetherhost/restic
ExecStart=/srv/aetherhost/control/deploy/backup/backup.sh
