[Unit]
Description=AetherHost non-destructive backup restore drill
Wants=network-online.target
After=network-online.target
OnFailure=aetherhost-operation-alert@%n.service

[Service]
Type=oneshot
TimeoutStartSec=2h
Environment=HOME=/root
Environment=XDG_CACHE_HOME=/var/cache/aetherhost/restic
ExecStart=/srv/aetherhost/control/deploy/backup/restore-check.sh
