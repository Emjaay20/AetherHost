[Unit]
Description=AetherHost bounded Docker cache maintenance
Wants=docker.service
After=docker.service
OnFailure=aetherhost-operation-alert@%n.service

[Service]
Type=oneshot
ExecStart=/usr/bin/docker buildx prune --all --force --max-used-space 10GB
ExecStart=/usr/bin/docker image prune --all --force --filter until=168h
