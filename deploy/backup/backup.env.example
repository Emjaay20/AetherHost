# Store the real version at /etc/aetherhost/backup.env with chmod 600.
# Google Drive setup: deploy/backup/GOOGLE_DRIVE_SETUP.md
RESTIC_REPOSITORY=rclone:gdrive:aetherhost-production
RESTIC_PASSWORD_FILE=/etc/aetherhost/restic-password
RCLONE_CONFIG=/etc/aetherhost/rclone.conf
# Passed to the rclone process started by Restic. Low concurrency avoids Google
# Drive request-rate errors while preserving encrypted, off-host snapshots.
RCLONE_RESTIC_ARGS="serve restic --stdio --b2-hard-delete --transfers 1 --checkers 1 --tpslimit 2 --tpslimit-burst 2 --retries 8"
RCLONE_TIMEOUT=5m
RESTIC_MAX_ATTEMPTS=3

# Preserve daily restore points for 14 days, weekly points for 8 weeks, and
# monthly points for 12 months. These can be adjusted to match your policy.
RESTIC_KEEP_DAILY=14
RESTIC_KEEP_WEEKLY=8
RESTIC_KEEP_MONTHLY=12
