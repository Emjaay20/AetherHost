# =============================================================================
# AETHERHOST API ENVIRONMENT EXAMPLE
# Copy this file to apps/api/.env and populate with your local/sandbox keys
# =============================================================================

DATABASE_URL="postgresql://aether:aetherpass@localhost:5435/aetherhost?schema=public"
REDIS_HOST="localhost"
REDIS_PORT="6379"
REDIS_PASSWORD="aether-redis-local"

CLERK_PUBLISHABLE_KEY="pk_test_replace_with_clerk_publishable_key"
CLERK_SECRET_KEY="sk_test_replace_with_clerk_secret_key"

GROQ_API_KEY="gsk_replace_with_groq_api_key"
GROQ_MODEL="openai/gpt-oss-120b"

BACHS_SECRET_KEY="sk_sandbox_replace_with_bachs_secret_key"
BACHS_API_URL="https://api.bachs.dev"
BACHS_WEBHOOK_SECRET="whsec_replace_with_bachs_webhook_secret"
BACHS_WEBHOOK_URL="http://localhost:3000/api/v1/billing/webhooks"

AGENT_SECRET_KEY="replace_with_random_32_byte_hex_secret"
DEFAULT_SYSTEM_TENANT_ID="user_system_default"
