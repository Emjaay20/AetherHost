{
  "moduleFileExtensions": ["js", "json", "ts"],
  "rootDir": ".",
  "testEnvironment": "node",
  "testRegex": ".e2e-spec.ts$",
  "transform": {
    "^.+\\.(t|j)s$": "ts-jest"
  },
  "moduleNameMapper": {
    "^@aetherhost/domain$": "<rootDir>/../../../libs/domain/src/index.ts",
    "^@aetherhost/common$": "<rootDir>/../../../libs/common/src/index.ts"
  }
}
