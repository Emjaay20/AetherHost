# The Clerk publishable key used by the existing AetherHost dashboard.
EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_replace_with_clerk_publishable_key

# Public HTTPS address of the AetherHost API on your VPS.
EXPO_PUBLIC_API_URL=https://api.yourdomain.com

# Added by `eas init`; required to register an Expo push token in a non-EAS development build.
EXPO_PUBLIC_EAS_PROJECT_ID=your-eas-project-id
