# =============================================================================
# AETHERHOST PRODUCTION CONFIGURATION FOR CONTABO VPS
# Copy to .env.production on your Contabo VPS and fill in values
# =============================================================================

# Domain & Networking
# e.g., yourdomain.com or aetherhost.io
BASE_DOMAIN=yourdomain.com
ACME_EMAIL=admin@yourdomain.com
HOST_PWD=/opt/aetherhost

# Database Configuration (PostgreSQL)
POSTGRES_USER=aether
POSTGRES_PASSWORD=generate_a_super_strong_password_here_32chars
POSTGRES_DB=aetherhost

# Redis Configuration
REDIS_PASSWORD=generate_a_strong_redis_password_here_32chars

# Security Keys
# Used for internal communication between Go Agent and NestJS API
AGENT_SECRET_KEY=generate_a_cryptographically_secure_agent_key_64chars

# Authentication (Clerk Production)
# Get from Clerk Dashboard -> API Keys
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_live_...
CLERK_PUBLISHABLE_KEY=pk_live_...
CLERK_SECRET_KEY=sk_live_...

# AI Architect Engine
GROQ_API_KEY=gsk_...
GROQ_MODEL=openai/gpt-oss-120b

# GitHub Integration (Optional - for GitHub push-to-deploy webhooks)
GITHUB_WEBHOOK_SECRET=your_github_webhook_secret_here
